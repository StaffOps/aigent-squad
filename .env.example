# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# LLM provider (spec 28) — GLOBAL. bedrock (default, unchanged behavior) | openai
# (any OpenAI-compatible POST {OPENAI_BASE_URL}/chat/completions: OpenAI, Azure
# OpenAI-compatible, vLLM, Ollama, OpenRouter, LiteLLM proxy).
# WARNING: with LLM_PROVIDER=openai the Bedrock Guardrail (L1) is switched OFF
# automatically (documented exception to fail-closed — ADR-0009); L2-L6 stay on.
LLM_PROVIDER=bedrock
# Provider-neutral model ids. bedrock: unset → BEDROCK_* role vars.
# openai: LLM_MODEL_ID is REQUIRED; classifier/synthesis fall back to it.
# LLM_MODEL_ID=
# LLM_CLASSIFIER_MODEL_ID=
# LLM_SYNTHESIS_MODEL_ID=
# Pricing for non-Bedrock models (USD per 1M tokens). Unset → cost metrics read 0.
# LLM_PRICE_INPUT_PER_1M=
# LLM_PRICE_OUTPUT_PER_1M=
# OpenAI-compatible endpoint (only when LLM_PROVIDER=openai). Secret: prefer the file.
# Base URL WITHOUT /chat/completions; a query string is kept (Azure: ?api-version=...).
# Plain http:// is refused at startup unless the host is local/in-cluster
# (localhost, 127.0.0.1, ::1, *.svc, *.svc.cluster.local, single-label names).
# HTTP(S)_PROXY env vars are NOT honored and redirects are NOT followed.
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY_FILE=/etc/secrets/openai-api-key
# OPENAI_API_KEY=
# Header carrying the key: "Authorization" sends "Bearer <key>"; use "api-key" for Azure.
# OPENAI_API_KEY_HEADER=Authorization
# Output-token cap field: use "max_completion_tokens" for OpenAI reasoning models.
# OPENAI_MAX_TOKENS_FIELD=max_tokens

# Bedrock Guardrail — anti-prompt-injection (spec 14). Fail-closed:
# GUARDRAIL_ENABLED=true with no GUARDRAIL_ID set → every invoke is refused.
# Provision via infra/terraform/guardrail (outputs guardrail_id/version).
# Set GUARDRAIL_ENABLED=false for local dev without a provisioned guardrail.
GUARDRAIL_ENABLED=true
GUARDRAIL_ID=          # from terraform output guardrail_id
GUARDRAIL_VERSION=DRAFT  # from terraform output guardrail_version (pin in prod)

# Edge gateway (spec 31) — the gateway fronts the supervisor.
# SUPERVISOR_INTERNAL_TOKEN is DISTINCT from INTERNAL_API_TOKEN: it gates the
# supervisor's gateway-only /internal/process. Fail-closed if unset.
SUPERVISOR_INTERNAL_TOKEN=your-distinct-internal-token
SUPERVISOR_URL=http://localhost:8001   # where the gateway forwards (supervisor Service)
GATEWAY_API_KEYS=                       # optional csv allowlist for X-API-Key edge auth
GATEWAY_KEY_AGENT_MAP=                  # optional per-consumer scope: "key1:observability,key2:kubernetes"
                                        #   maps a credential to a DEFAULT agent on auto-route models
                                        #   (base/large). An explicit aigent-squad-<agent> model still
                                        #   wins — this is scoping, NOT an auth boundary.
GATEWAY_MAX_CONCURRENT=20               # local worker-pool cap (per replica)
GATEWAY_JOB_TIMEOUT_SECONDS=45
GATEWAY_FIRST_BYTE_TIMEOUT_SECONDS=15
GATEWAY_IDLE_STREAM_TIMEOUT_SECONDS=10

# Admission guards (spec 31 L3) — global, Redis-coordinated, fail-open.
RATE_BUDGET_ENABLED=true
RATE_LIMIT_PER_MINUTE=60                 # per-user sliding window
DAILY_BUDGET_USD=50.0                    # global daily Bedrock spend cap

# Security
INTERNAL_API_TOKEN=your-secret-token-here
REDIS_PASSWORD=your-redis-password

# DynamoDB
DYNAMODB_SESSIONS_TABLE=agent-sessions

# ElastiCache
REDIS_HOST=your-redis-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_SSL=true

# Slack (get from Slack App settings)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_PROACTIVE_CHANNEL=C12345678

# API
API_HOST=0.0.0.0
API_PORT=8000

# GitLab (DevOps Agent - READ-ONLY access)
GITLAB_TOKEN=glpat-your-read-only-token
GITLAB_URL=https://gitlab.com

# Spec 46 — per-environment MCP addresses (unset = that datasource is dropped, agent still loads)
# K8S_MCP_URL=http://<kubernetes-mcp-service>:8080/mcp
# VM_MCP_URL=http://<metrics-mcp-service>:8080/mcp
# Per-environment agent switch, e.g. off-AWS:
# AGENT_AWS_ENABLED=false
# AGENT_FINOPS_ENABLED=false

# Kubecost Athena (FinOps Agent)
ATHENA_PROJECT_ID=123456789012
ATHENA_BUCKET=s3://company-athena-kubecost
ATHENA_REGION=us-east-1
ATHENA_DATABASE=kubecost
ATHENA_TABLE=kubecost_split
ATHENA_WORKGROUP=primary

# Documentation Portal (DevOps Agent)
DOCS_PORTAL_URL=https://docs.company.internal/
DOCS_PORTAL_URL_NEW=https://docs.company.com/

# RAG / Knowledge Base (FinOps Agent)
RAG_ENABLED=false
FINOPS_KNOWLEDGE_BASE_ID=  # Bedrock Knowledge Base ID (optional)
