# AWS
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Bedrock Guardrail — anti-prompt-injection (spec 14). Fail-closed:
# GUARDRAIL_ENABLED=true with no GUARDRAIL_ID set → every invoke is refused.
# Provision via infra/terraform/guardrail (outputs guardrail_id/version).
# Set GUARDRAIL_ENABLED=false for local dev without a provisioned guardrail.
GUARDRAIL_ENABLED=true
GUARDRAIL_ID=          # from terraform output guardrail_id
GUARDRAIL_VERSION=DRAFT  # from terraform output guardrail_version (pin in prod)

# Security
INTERNAL_API_TOKEN=your-secret-token-here
REDIS_PASSWORD=your-redis-password

# DynamoDB
DYNAMODB_SESSIONS_TABLE=agent-sessions

# ElastiCache
REDIS_HOST=your-redis-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_SSL=true

# Slack (get from Slack App settings)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_PROACTIVE_CHANNEL=C12345678

# API
API_HOST=0.0.0.0
API_PORT=8000

# GitLab (DevOps Agent - READ-ONLY access)
GITLAB_TOKEN=glpat-your-read-only-token
GITLAB_URL=https://gitlab.com

# Kubecost Athena (FinOps Agent)
ATHENA_PROJECT_ID=123456789012
ATHENA_BUCKET=s3://company-athena-kubecost
ATHENA_REGION=us-east-1
ATHENA_DATABASE=kubecost
ATHENA_TABLE=kubecost_split
ATHENA_WORKGROUP=primary

# Documentation Portal (DevOps Agent)
DOCS_PORTAL_URL=https://docs.company.internal/
DOCS_PORTAL_URL_NEW=https://docs.company.com/

# RAG / Knowledge Base (FinOps Agent)
RAG_ENABLED=false
FINOPS_KNOWLEDGE_BASE_ID=  # Bedrock Knowledge Base ID (optional)
