    "/internal/process/stream": {
      "post": {
        "summary": "Internal Process Stream",
        "description": "Streaming process endpoint (Phase 3.5, S1).\n\nReturns an SSE stream of OpenAI chat.completion.chunk frames as the agentic\nloop executes — reasoning, tool calls, results, and final answer stream live.\nFalls back to pseudo-streaming (full answer as one delta) for non-agentic paths\n(classifier, investigation, fan-out).",
        "operationId": "internal_process_stream_internal_process_stream_post",
        "parameters": [
          {
            "name": "x-supervisor-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Supervisor-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Internal Process Stream Internal Process Stream Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
