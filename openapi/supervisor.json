{
  "openapi": "3.1.0",
  "info": {
    "title": "Supervisor Service",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/process": {
      "post": {
        "summary": "Internal Process",
        "description": "Gateway-only orchestration entrypoint (spec 31).\n\nThe edge gateway forwards here after admission control (auth, rate/budget,\nworker pool). This is a thin wrapper over the existing ``process_request`` —\nthe supervisor's orchestration is unchanged. The guardrail (spec 14) runs\ninside ``process_request`` on every call, regardless of caller, so the\ninjection-defense trust boundary stays here, not at the gateway.\n\nSession lock (spec 25 T3): prevents duplicate concurrent processing of the\nsame session_id across replicas. Fail-open if Redis is down.",
        "operationId": "internal_process_internal_process_post",
        "parameters": [
          {
            "name": "x-supervisor-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Supervisor-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Internal Process Internal Process Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
